package web

import "github.com/melodyogonna/solai/controlplane"

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			<h1><a href="/">SolAI</a></h1>
			{ children... }
		</body>
	</html>
}

templ indexPage(sessions []*controlplane.Session) {
	@layout("SolAI") {
		<h2>Start a session</h2>
		<form hx-post="/sessions" hx-target="#sessions" hx-swap="outerHTML">
			<textarea name="goals" rows="3" placeholder="One goal per line" required></textarea>
			<p><button type="submit">Start</button></p>
		</form>

		<h2>Sessions</h2>
		@sessionsList(sessions)
	}
}

templ sessionsList(sessions []*controlplane.Session) {
	<ul id="sessions">
		for _, s := range sessions {
			<li>
				<a href={ "/sessions/" + s.ID }>{ s.ID }</a>
				— { s.Status }
			</li>
		}
	</ul>
}

templ sessionPage(s *controlplane.Session) {
	@layout("Session " + s.ID) {
		<p><a href="/">← All sessions</a></p>
		<h2>Session { s.ID }</h2>
		<p>Status: { s.Status }</p>

		<h3>Goals</h3>
		<ul>
			for _, g := range s.Goals {
				<li>{ g.Text } — { string(g.Status) }</li>
			}
		</ul>

		<h3>Output</h3>
		<div id="events" class="events" data-session={ s.ID }></div>
		<script src="/static/session.js"></script>
	}
}
