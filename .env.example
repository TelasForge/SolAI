# SolAI local development environment.
#
# Copy to .env and fill in. `make run` loads it via `go tool godotenv -o -f .env`.
# .env is gitignored; commit changes to this example instead.

# --- Required -------------------------------------------------------------
SOLAI_MODEL=anthropic/claude-sonnet-4
OPENROUTER_API_KEY=

# --- Optional -------------------------------------------------------------
SOLAI_OPENROUTER_BASE_URL=
SOLAI_WALLET_SEED=
SOLAI_RPC_URL=https://api.mainnet-beta.solana.com
SOLAI_COMMITMENT=confirmed
SOLAI_LOG_LEVEL=info
